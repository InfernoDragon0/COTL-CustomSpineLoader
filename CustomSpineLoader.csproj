<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <AssemblyName>CultTweaker</AssemblyName>
        <AssemblyVersion>1.0.0</AssemblyVersion>
        <ReleaseVersion>1.0.0</ReleaseVersion>
        <TargetFramework>netstandard2.1</TargetFramework>
        <LangVersion>latest</LangVersion>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <DebugType>full</DebugType>

        <OutputPath Condition=" '$(SolutionDir)' != '' ">$(SolutionDir)bin\$(Configuration)\$(MSBuildProjectName)\</OutputPath>
        <OutputPath Condition=" '$(SolutionDir)' == '' ">$(ProjectDir)bin\$(Configuration)\$(MSBuildProjectName)\</OutputPath>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
        <PackageReference Include="BepInEx.Core" Version="5.4.21" />
        <PackageReference Include="UnityEngine.Modules" Version="2021.3.16" IncludeAssets="compile" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework.TrimEnd(`0123456789`))' == 'net'">
        <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.2" PrivateAssets="all" />

    </ItemGroup>

    <!-- The game's own assemblies for 1.5.26.1057, publicized and stripped to reference-only, in
         lib\GameLibs. This replaces the CultOfTheLamb.GameLibs NuGet package, which stops at
         1.5.15.979 (https://nuget.bepinex.dev tops out there), so there is nothing to reference for
         a 1.5.26 game. Rebuild them with tools/gamelibs.sh after a game update.
         Newtonsoft.Json comes from the game too, so the compile-time API matches the 13.0.0.0 the
         game actually loads rather than the 12.0.3 the old package pinned. The two Rewired
         assemblies are copied untouched; tools/gamelibs.sh says why. -->
    <ItemGroup>
      <Reference Include="Assembly-CSharp-firstpass" Private="false">
        <HintPath>lib\GameLibs\Assembly-CSharp-firstpass.dll</HintPath>
      </Reference>
      <Reference Include="Assembly-CSharp" Private="false">
        <HintPath>lib\GameLibs\Assembly-CSharp.dll</HintPath>
      </Reference>
      <Reference Include="DOTween" Private="false">
        <HintPath>lib\GameLibs\DOTween.dll</HintPath>
      </Reference>
      <Reference Include="FMODUnity" Private="false">
        <HintPath>lib\GameLibs\FMODUnity.dll</HintPath>
      </Reference>
      <Reference Include="GalaxyCSharp" Private="false">
        <HintPath>lib\GameLibs\GalaxyCSharp.dll</HintPath>
      </Reference>
      <Reference Include="LeTai.TranslucentImage" Private="false">
        <HintPath>lib\GameLibs\LeTai.TranslucentImage.dll</HintPath>
      </Reference>
      <Reference Include="Newtonsoft.Json" Private="false">
        <HintPath>lib\GameLibs\Newtonsoft.Json.dll</HintPath>
      </Reference>
      <Reference Include="Rewired_Core" Private="false">
        <HintPath>lib\GameLibs\Rewired_Core.dll</HintPath>
      </Reference>
      <Reference Include="Rewired_Windows" Private="false">
        <HintPath>lib\GameLibs\Rewired_Windows.dll</HintPath>
      </Reference>
      <Reference Include="Sirenix.Serialization" Private="false">
        <HintPath>lib\GameLibs\Sirenix.Serialization.dll</HintPath>
      </Reference>
      <Reference Include="Sirenix.Utilities" Private="false">
        <HintPath>lib\GameLibs\Sirenix.Utilities.dll</HintPath>
      </Reference>
      <Reference Include="Unity.Addressables" Private="false">
        <HintPath>lib\GameLibs\Unity.Addressables.dll</HintPath>
      </Reference>
      <Reference Include="Unity.Mathematics" Private="false">
        <HintPath>lib\GameLibs\Unity.Mathematics.dll</HintPath>
      </Reference>
      <Reference Include="Unity.ProBuilder" Private="false">
        <HintPath>lib\GameLibs\Unity.ProBuilder.dll</HintPath>
      </Reference>
      <Reference Include="Unity.ResourceManager" Private="false">
        <HintPath>lib\GameLibs\Unity.ResourceManager.dll</HintPath>
      </Reference>
      <Reference Include="Unity.TextMeshPro" Private="false">
        <HintPath>lib\GameLibs\Unity.TextMeshPro.dll</HintPath>
      </Reference>
      <Reference Include="UnityEngine.UI" Private="false">
        <HintPath>lib\GameLibs\UnityEngine.UI.dll</HintPath>
      </Reference>
      <Reference Include="spine-unity" Private="false">
        <HintPath>lib\GameLibs\spine-unity.dll</HintPath>
      </Reference>
    </ItemGroup>

    <!-- Decodes a cutscene's audio track through Windows' own codecs. Shipped alongside the
         plugin (BepInEx resolves from the plugin folder), which is why it is not PrivateAssets. -->
    <ItemGroup>
        <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    </ItemGroup>

    <ItemGroup>
      <Reference Include="COTL_API" Private="false">
        <HintPath>lib\COTL_API.dll</HintPath>
      </Reference>
      <Reference Include="AstarPathfindingProject" Private="false">
        <HintPath>lib\AstarPathfindingProject.dll</HintPath>
      </Reference>
      <Reference Include="Unity.2D.SpriteShape.Runtime" Private="false">
        <HintPath>lib\Unity.2D.SpriteShape.Runtime.dll</HintPath>
      </Reference>
      <Reference Include="Unity.2D.Common.Runtime" Private="false">
        <HintPath>lib\Unity.2D.Common.Runtime.dll</HintPath>
      </Reference>
    </ItemGroup>

    <ItemGroup>
      <Folder Include="APIHelper\" />
    </ItemGroup>

    <!-- Only NAudio's own assemblies are copied out, by name: turning on
         CopyLocalLockFileAssemblies would drop the Unity and BepInEx reference assemblies into
         the plugin folder too, which is how a plugin ends up loading a second UnityEngine. -->
    <Target Name="CopyNAudio" AfterTargets="Build">
        <ItemGroup>
            <NAudioAssemblies Include="@(ReferencePath)"
                              Condition="$([System.String]::Copy('%(Filename)').StartsWith('NAudio'))" />
        </ItemGroup>
        <Copy SourceFiles="@(NAudioAssemblies)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
    </Target>

</Project>
